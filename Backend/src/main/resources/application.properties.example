# Tên ?ng d?ng
spring.application.name=DoanBE
server.port=8080

# C?u hình k?t n?i MySQL
spring.datasource.url=jdbc:mysql://localhost:3306/fitness_db?useSSL=false&serverTimezone=UTC
spring.datasource.username=root
spring.datasource.password={your_pw}

# Khai báo Dialect (ph??ng ng?) cho MySQL
spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect

# Dùng 'create' khi chạy lần đầu để tạo bảng
# Dùng 'update' cho các l?n ch?y sau
# spring.jpa.hibernate.ddl-auto=create
spring.jpa.show-sql=true
spring.jpa.hibernate.naming.physical-strategy=org.hibernate.boot.model.naming.PhysicalNamingStrategyStandardImpl

#OAUTH Config
spring.security.oauth2.client.registration.google.client-id={your_client_id}
spring.security.oauth2.client.registration.google.client-secret={your_client_secrete}
spring.security.oauth2.client.registration.google.scope=email, profile


#GMAIL SMTP
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username={your_username}
spring.mail.password={yout_pw}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

logging.level.org.springframework.security=DEBUG

#JWT
jwt.expiration = 2592000
jwt.expiration-refresh-token = 5184000
jwt.reset-password-expiration = 600
jwt.secretKey = eybb+/++uLfMDzpiLPeyPdvPpAtYDxYSsfBNp5RSSaU=

#API_PREFIX
api.prefix = api

app.oauth2.redirect-uri=http://localhost:5173/oauth2/redirect

#SWAGGER
open.api.title=Fitness Service Documents
open.api.version=v.1.0.0
open.api.serverUrl=http://localhost:8080

# Cloudinary Config
cloudinary.cloud-name=ten_cloud_cua_ban
cloudinary.api-key=api_key_cua_ban
cloudinary.api-secret=api_secret_cua_ban

#File size
spring.servlet.multipart.max-file-size=50MB
spring.servlet.multipart.max-request-size=50MB

# 1. API Key của Google (Lấy tại aistudio.google.com)
spring.ai.openai.api-key=AIza.................(Tu Lay Key Di)
spring.ai.openai.base-url=https://generativelanguage.googleapis.com/v1beta/openai/
spring.ai.openai.chat.options.model=gemini-2.5-flash
spring.ai.openai.chat.options.temperature=0.7