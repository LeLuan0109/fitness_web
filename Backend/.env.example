# ============================================================================
# Biến môi trường cho docker-compose-product.yml
# Copy file này thành .env rồi điền giá trị thật:  cp .env.example .env
# KHÔNG commit file .env (chứa secret).  Mọi biến đều có default nên có thể chạy ngay.
# ============================================================================

# ---- Cổng backend ----
BACKEND_PORT=8080

# ---- Database MySQL ngoài (mặc định 10.10.100.100:3311) ----
DB_HOST=10.10.100.100
DB_PORT=3311
DB_NAME=fitness_db
DB_USERNAME=root
DB_PASSWORD=fitness123

# ---- JWT (nên tạo key mới ở production:  openssl rand -base64 32) ----
JWT_SECRET_KEY=eybb+/++uLfMDzpiLPeyPdvPpAtYDxYSsfBNp5RSSaU=

# ---- URLs công khai ----
OAUTH2_REDIRECT_URI=http://localhost:5173/oauth2/redirect
OPENAPI_SERVER_URL=http://localhost:8080

# ---- Cloudinary (upload ảnh) ----
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=demo_secret

# ---- Gemini AI (chatbot) ----
GEMINI_API_KEY=AIzaPLACEHOLDER

# ---- Mail SMTP (tùy chọn) ----
MAIL_USERNAME=
MAIL_PASSWORD=

# ---- Google OAuth2 (tùy chọn) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- JVM ----
JAVA_TOOL_OPTIONS=-Xms256m -Xmx768m
