# ============================================================================
# Biến môi trường cho docker-compose-product.yml
# Copy file này thành .env rồi đổi giá trị nếu cần:  cp .env.example .env
# KHÔNG commit file .env. Mọi biến đều có default nên có thể chạy ngay.
#
# Ghi chú: Cloudinary / Gemini / Google OAuth / Mail / JWT dùng chung, đã nằm
# trong application.yml (base) -> KHÔNG cần khai báo ở đây.
# ============================================================================

# ---- Cổng backend (host) ----
BACKEND_PORT=8010

# ---- Database MySQL server thật (mặc định 10.10.100.100:3311, root/fitness123) ----
DB_HOST=10.10.100.100
DB_PORT=3311
DB_NAME=fitness_db
DB_USERNAME=root
DB_PASSWORD=fitness123

# ---- URL công khai (đổi theo domain production nếu deploy domain thật) ----
OAUTH2_REDIRECT_URI=http://localhost:5173/oauth2/redirect
OPENAPI_SERVER_URL=http://localhost:8080

# ---- JVM ----
JAVA_TOOL_OPTIONS=-Xms256m -Xmx768m
